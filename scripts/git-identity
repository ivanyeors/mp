#!/usr/bin/env bash
# Pin this clone's commit author to the identity Vercel will build for.
#
# Vercel refuses to build a deployment whose GIT COMMIT AUTHOR is not a member
# of the team that owns the project. It does not fail the build — it never
# starts one. The deployment is created in state BLOCKED with buildingAt ==
# ready == createdAt and no build events at all, and the pull request simply
# shows no preview. Nothing in the repository, in CI, or on the Checks tab says
# why.
#
# That is how #198 lost its preview. Two agent sessions committed under a
# platform-login address instead of a git identity, and GitHub resolved it to a
# different account. The Vercel team `ivanyeors-projects` has exactly one
# member, `ivanyeors`, so every commit those sessions authored was blocked on
# arrival. Every other branch in the repository built fine. Production never
# broke, because GitHub rewrites the author to ivanyeors on squash-merge —
# which is also why this went unnoticed for six days.
#
# Login addresses are not git identities. An address used to sign in to the
# platform, a mail provider or any other service never goes in user.email here,
# whatever else it is used for. The only git author this repository has is the
# one below.
#
# So: pin the author, in the clone, before anything can commit. This runs from
# the SessionStart hook in .claude/settings.json, and by hand once per clone:
#
#     ./scripts/git-identity
#
# Local config beats global, so this wins over whatever identity the agent
# container or the developer's ~/.gitconfig supplies. The Co-Authored-By
# trailer is what credits the agent on a commit; the author field is what
# Vercel reads, and it has to be an account on the team.
#
# Skip it for one command with: MP_SKIP_GIT_IDENTITY=1 ...
#
# Exits 0 on every path it does not understand. A SessionStart hook that fails
# is a session that fails, and no identity is worth that.
set -uo pipefail

[ "${MP_SKIP_GIT_IDENTITY:-}" = "1" ] && exit 0

# The one identity that deploys this project. GitHub has this address verified
# on the account `ivanyeors` (id 47745593), which owns the Vercel team, so a
# commit authored with it is attributed to that account and built. It is not a
# guess: 567 commits in this history carry it, and 73a8eed4 — authored with
# exactly this name and address — produced a READY Vercel preview.
AUTHOR_NAME="ivanyeors"
AUTHOR_EMAIL="ivanyeoart@gmail.com"

root="${CLAUDE_PROJECT_DIR:-}"
if [ -z "$root" ]; then
  root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)" || exit 0
fi
cd "$root" 2>/dev/null || exit 0

git rev-parse --git-dir >/dev/null 2>&1 || exit 0

git config user.name "$AUTHOR_NAME" || exit 0
git config user.email "$AUTHOR_EMAIL" || exit 0

# Author and committer are two fields, read by two different things. Vercel and
# .githooks/pre-push read the AUTHOR, pinned above. GitHub's "Verified" badge
# reads the COMMITTER: it has to be the address the signing key is registered
# to. A Claude cloud session signs every commit with its own key
# (~/.gitconfig: commit.gpgsign, user.email noreply@anthropic.com) and its stop
# hook refuses to end a turn on a commit whose committer is anyone else. With
# only user.* set, that session's commits were authored AND committed as us,
# signed by a key that is not ours: Unverified on GitHub, and a session that
# could not stop.
#
# So where the surrounding config signs as its own identity, commit as that
# identity and keep authoring as ours: the preview builds, the push passes and
# the commit is Verified. On a machine that does not sign, or signs as us,
# nothing below runs and both fields stay the pinned author, as before.
signer_email="$(git config --global --get user.email 2>/dev/null || true)"
signer_name="$(git config --global --get user.name 2>/dev/null || true)"
if [ "$(git config --global --type=bool --get commit.gpgsign 2>/dev/null || true)" = "true" ] &&
  [ -n "$signer_email" ] && [ "$signer_email" != "$AUTHOR_EMAIL" ]; then
  git config committer.name "${signer_name:-$signer_email}" || true
  git config committer.email "$signer_email" || true
fi

# .githooks/pre-push is the backstop for anything that commits without this
# script having run — another tool, another machine, a clone made before this
# landed. .githooks/pre-commit commits a pruned lint baseline. The path is
# relative, so each worktree runs its own checkout's hooks. Only claim
# core.hooksPath if nothing else has: a contributor who has pointed it
# somewhere deliberately keeps their hooks, and both hooks are conveniences
# (CI is the backstop), not the mechanism.
current_hooks_path="$(git config --get core.hooksPath || true)"
if [ -z "$current_hooks_path" ] || [ "$current_hooks_path" = ".githooks" ]; then
  git config core.hooksPath .githooks || true
fi

exit 0
