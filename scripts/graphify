#!/usr/bin/env bash
# Portable graphify launcher.
#
# Resolution order — the pinned uvx version comes FIRST, deliberately. The graph
# is committed and CI checks it for staleness, so a contributor running a
# different graphify version than CI would produce a different graph and fail
# the check with a confusing diff. Pinning here keeps every machine and CI on
# the same extractor. An unpinned `graphify` already on PATH is used only when
# uv is unavailable.
#
# The [sql] extra is not optional: without it the 103 files in
# supabase/migrations are skipped and the graph loses the whole DB schema.
#
# Override the pin for a one-off with: GRAPHIFY_VERSION=x.y.z ./scripts/graphify ...
# On a machine with neither uv nor graphify this exits silently, so the
# PreToolUse hooks in .claude/settings.json can never break a session.
set -uo pipefail

GRAPHIFY_VERSION="${GRAPHIFY_VERSION:-0.9.75}"

for uv_bin in uvx "$HOME/.local/bin/uvx"; do
  if command -v "$uv_bin" >/dev/null 2>&1; then
    exec "$uv_bin" --from "graphifyy[sql]==${GRAPHIFY_VERSION}" graphify "$@"
  fi
done

if command -v graphify >/dev/null 2>&1; then
  exec graphify "$@"
fi

exit 0
