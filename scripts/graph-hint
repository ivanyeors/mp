#!/usr/bin/env python3
"""PreToolUse hook: answer a search for a table or page from the data layer.

When an agent greps for a database table (`inventory_transactions`,
`.from("orders")`) or a page URL (`/settings/costings`), this adds that entry
from graphify-out/DATA_LAYER.md to the tool call: every function that writes
the table, who reads it, and which pages change it. The agent gets the
complete list of code paths up front instead of assembling it from grep hits,
and the one it would have missed is in the list.

Silent for every other tool call, and for a name it has already shown in this
session. Fails open: any error prints nothing, so a tool call is never blocked.
Wired in .claude/settings.json for Bash|Grep.
"""
import json
import os
import re
import shlex
import sys
import tempfile
from pathlib import Path

REPORT = Path(__file__).resolve().parent.parent / "graphify-out" / "DATA_LAYER.md"
SEARCH_TOOLS = {"grep", "egrep", "fgrep", "rg", "ag", "ack"}
# Words after which the next word is a command: `a | grep`, `xargs grep`, `git grep`.
COMMAND_POSITION = {"|", "||", "&&", ";", "&", "(", "$(", "xargs", "git", "time", "sudo"}
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n.*?^\s*\2\s*$", re.S | re.M)
MAX_ENTRIES = 2
LIMITS = {"Written by": 30, "Called by": 10, "Read by": 8}
MAX_LIST = 12  # names on one line, e.g. "Changed from pages: `/a`, `/b`, ..."


def sections(report: str) -> dict[str, list[str]]:
    """`### name` -> its lines, for the Tables and Pages parts of the report."""
    out: dict[str, list[str]] = {}
    current = None
    for line in report.splitlines():
        if line.startswith("## "):
            current = None
        elif line.startswith("### "):
            current = line[4:].strip()
            out[current] = []
        elif current is not None and line.strip():
            out[current].append(line)
    return out


def mentioned(text: str, names: dict[str, list[str]]) -> list[str]:
    """Tables and pages the search names, in order of appearance."""
    found = []
    for m in re.finditer(r"/[\w\-\[\]/]+|[A-Za-z_][A-Za-z0-9_]*", text):
        token = m.group(0).rstrip("/")
        if token not in names or token in found:
            continue
        if token.startswith("/"):
            found.append(token)
            continue
        # A table named by a plain word (orders, items) counts only when the
        # search is clearly about the table: quoted, after .from(, or alone.
        before = text[max(0, m.start() - 8):m.start()]
        after = text[m.end():m.end() + 1]
        quoted = before[-1:] in "\"'`" and after in "\"'`"
        if "_" in token or quoted or "from(" in before or text.strip(" \"'") == token:
            found.append(token)
    return found


def render(name: str, lines: list[str]) -> str:
    out, heading, shown, hidden = [f"### {name}"], None, 0, 0
    for line in lines:
        if line.startswith("- ") and line.rstrip(":")[2:] in LIMITS:
            if hidden:
                out.append(f"  - … {hidden} more")
            heading, shown, hidden = line.rstrip(":")[2:], 0, 0
            out.append(line)
            continue
        if line.startswith("  - ") and heading:
            if shown < LIMITS[heading]:
                out.append(line)
                shown += 1
            else:
                hidden += 1
            continue
        if hidden:
            out.append(f"  - … {hidden} more")
            hidden = 0
        heading = None
        out.append(shorten(line))
    if hidden:
        out.append(f"  - … {hidden} more")
    return "\n".join(out)


def runs_search(command: str) -> bool:
    """Whether a shell command runs grep/rg/..., as opposed to mentioning it in text."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        words = list(lexer)
    except ValueError:  # unbalanced quotes: not worth guessing
        return False
    prev = None
    for word in words:
        if word in SEARCH_TOOLS and (prev is None or prev in COMMAND_POSITION or prev.endswith("$(")):
            return True
        prev = word
    return False


def shorten(line: str) -> str:
    """Cap a `a`, `b`, ... list at MAX_LIST names."""
    items = re.findall(r"`[^`]+`", line)
    if len(items) <= MAX_LIST:
        return line
    cut = line.index(items[MAX_LIST - 1]) + len(items[MAX_LIST - 1])
    return f"{line[:cut]}, … {len(items) - MAX_LIST} more"


def main() -> None:
    event = json.loads(sys.stdin.read() or "{}")
    tool = event.get("tool_input") or {}
    command = str(tool.get("command") or "")
    if command:
        # Heredoc bodies and quoted strings are data, not commands: "you grep
        # for" in a commit message is not a search.
        command = HEREDOC.sub("", command)
        if not runs_search(command):
            return
        text = command
    else:
        text = str(tool.get("pattern") or "")
    if not text or not REPORT.is_file():
        return

    entries = sections(REPORT.read_text(encoding="utf-8"))
    names = mentioned(text, entries)
    if not names:
        return

    # Show each entry once per session; a second grep for the same table
    # already has it in context.
    seen_file = Path(tempfile.gettempdir()) / f"graph-hint-{event.get('session_id', 'none')}"
    seen = set(seen_file.read_text().split("\n")) if seen_file.is_file() else set()
    fresh = [n for n in names if n not in seen][:MAX_ENTRIES]
    if not fresh:
        return
    with seen_file.open("a") as fh:
        fh.write("".join(n + "\n" for n in fresh))

    body = "\n\n".join(render(n, entries[n]) for n in fresh)
    note = "" if all(n.startswith("/") for n in fresh) else (
        " \"Written by\" is every code path that changes the table; \"Changed from pages\" is approximate."
    )
    context = (
        f"Data layer entry for what you are searching (graphify-out/DATA_LAYER.md, generated from the code).{note}\n\n"
        f"{body}\n\nMore: ./scripts/graphify explain \"<name>\" · docs/data-flows/"
    )
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {"hookEventName": "PreToolUse", "additionalContext": context}
    }))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
