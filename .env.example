# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin of the site. Used for auth OAuth/magic-link callbacks, Stripe
# Checkout success/cancel redirects, and sitemap/robots. No trailing slash.
# Production (Vercel): https://custom.mpillow.com  —  Dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Analytics & Search Console (Slice 11)
# ---------------------------------------------------------------------------
# Google Tag Manager container ID (optional — loads in production only)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Google Analytics 4 measurement ID (optional alternative/complement to GTM)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Search Console HTML tag verification content value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and keys from the Supabase dashboard (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Auth (Supabase Auth: Google OAuth + email magic link)
# ---------------------------------------------------------------------------
# Provider configuration is done in the Supabase dashboard, not here:
#   Authentication > Providers > Google  (enable, paste Google OAuth client
#     id/secret from Google Cloud > APIs & Services > Credentials)
#   Authentication > Providers > Email   (enable, "Confirm email" / magic link)
#   Authentication > URL Configuration:
#     Site URL: https://your-domain (must match NEXT_PUBLIC_SITE_URL in prod)
#     Redirect URLs: add each origin you use. For local dev, wildcards avoid
#     port drift when Next picks 3001 (keep Site URL as production):
#       https://custom.mpillow.com/**
#       https://work.mpillow.com/**
#       http://localhost:3000/**
#       http://localhost:3001/**
#       http://127.0.0.1:3000/**
#
# Login surfaces:
#   - Customer login (/account/login): Google OAuth + email magic link.
#   - Staff settings login (/settings/login): Google OAuth only.
#
# Comma-separated allowlist of staff emails permitted into the admin/settings
# area. A matching email can sign in and bootstrap the owner role before any
# admin_users rows exist (see Admin RBAC). Note: sg@mpillow.com and
# admin@mpillow.com are always allowed in code regardless of this value.
ADMIN_BOOTSTRAP_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Bearer secret for /api/cron/* routes. Required in production.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Telegram (inventory commands)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional comma-separated chat id allowlist; empty = allow all
TELEGRAM_ALLOWED_CHATS=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Prefer a Restricted API Key (rk_...) over the full secret key (sk_...).
# Scopes needed by this app: Products (Write), Prices (Write),
# Checkout Sessions (Write), Payment Links (Write), PaymentIntents (Read/Write),
# Charges (Read), Refunds (Write). Generate in Dashboard > Developers > API keys.
#
# Local E2E (test cards like 4242…): Dashboard must be in Test mode (toggle
# top-right). Keys must start with sk_test_ / rk_test_ / pk_test_ — live keys
# reject test card numbers. Probe UI: http://localhost:3000/stripe-test
# Webhooks: npm run stripe:listen  → paste printed whsec_… below, restart dev.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook.
# Dashboard > Developers > Webhooks (whsec_...). For local dev use the value
# printed by: npm run stripe:listen
STRIPE_WEBHOOK_SECRET=
# Optional: only needed if you embed Stripe Elements. The storefront currently
# redirects to hosted Checkout, so this can be left blank.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to "true" to let Stripe Tax compute GST on the post-discount amount
# (writes the final tax/total back from the completed session). PREREQUISITE:
# enable Stripe Tax and add the SG GST registration in the Dashboard first,
# otherwise automatic_tax returns 0 / errors. Left blank/false keeps the manual
# exclusive-tax line item. The discount-as-coupon fix is always on regardless.
STRIPE_AUTOMATIC_TAX=
# Optional: Stripe tax code applied to synced Products (Stripe Tax category).
# Defaults to txcd_99999999 (General - Tangible Goods).
STRIPE_TAX_CODE=

# ---------------------------------------------------------------------------
# Shopify (inventory sync)
# ---------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=

# ---------------------------------------------------------------------------
# Google Maps / Places (store locator, reviews)
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_MAPS_API_REFERRER=http://localhost:3000/

# ---------------------------------------------------------------------------
# Google Calendar + Contacts (appointment reminders, admin@mpillow.com)
# ---------------------------------------------------------------------------
# OAuth desktop/web client with refresh token. Scopes:
#   https://www.googleapis.com/auth/calendar
#   https://www.googleapis.com/auth/contacts
# Enable Calendar API on the same GCP project as the OAuth client:
#   https://console.developers.google.com/apis/api/calendar-json.googleapis.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (appointment confirm / reschedule)
# ---------------------------------------------------------------------------
# System user token: whatsapp_business_messaging, whatsapp_business_management,
# business_management. Phone: +65 8780 5311 with Business app coexistence.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Approved English utility template names (Meta Business Manager)
WHATSAPP_TEMPLATE_DAY_BEFORE=appointment_day_before
WHATSAPP_TEMPLATE_MORNING_OF=appointment_morning_of
WHATSAPP_TEMPLATE_CANCEL=appointment_cancelled
# Non-prod only: comma-separated E.164 allowlist; empty = allow all
WHATSAPP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Email (support contact + transactional)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_EMAIL=
GMAIL_SENDER=
GMAIL_PRIVATE_KEY=
# EMAIL_FROM=
