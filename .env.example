# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin of the site. Used for auth OAuth/magic-link callbacks, Stripe
# Checkout success/cancel redirects, and sitemap/robots. No trailing slash.
# Production (Vercel): https://custom.mpillow.com  —  Dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Analytics & Search Console (Slice 11)
# ---------------------------------------------------------------------------
# Google Tag Manager — loads in production only (app/layout.tsx).
# Reuse the legacy Shopify container so existing tags keep firing:
# NEXT_PUBLIC_GTM_ID=GTM-TPB9LV2
# GA4 measurement ID — only if you need gtag outside GTM (usually skip; GTM owns GA)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Search Console HTML tag verification content value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and keys from the Supabase dashboard (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Customer privacy check (lib/shop/customer-privacy.check.ts, CRM 02). Optional:
# only that script reads these. Either a customer login with a password
# (Supabase dashboard > Authentication > Add user), or a real customer
# session's two tokens. With a site URL it also opens each account page.
# CUSTOMER_CHECK_EMAIL=
# CUSTOMER_CHECK_PASSWORD=
# CUSTOMER_CHECK_ACCESS_TOKEN=
# CUSTOMER_CHECK_REFRESH_TOKEN=
# CUSTOMER_CHECK_SITE_URL=http://localhost:3000

# Purchase-classes parity check (lib/crm/purchase-lines.check.ts, CRM 04).
# Optional: only that script reads it. A Postgres connection string for a
# database with every migration applied (Supabase dashboard > Connect > direct
# connection string, for a development project). It runs in one transaction
# that is rolled back, and needs psql on the PATH.
# CRM_CHECK_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Auth (Supabase Auth: Google OAuth + email magic link)
# ---------------------------------------------------------------------------
# Provider configuration is done in the Supabase dashboard, not here:
#   Authentication > Providers > Google  (enable, paste Google OAuth client
#     id/secret from Google Cloud > APIs & Services > Credentials)
#   Authentication > Providers > Email   (enable, "Confirm email" / magic link)
#   Authentication > URL Configuration:
#     Site URL: https://your-domain (must match NEXT_PUBLIC_SITE_URL in prod)
#     Redirect URLs: add each origin you use. For local dev, wildcards avoid
#     port drift when Next picks 3001 (keep Site URL as production):
#       https://custom.mpillow.com/**
#       https://work.mpillow.com/**
#       http://localhost:3000/**
#       http://localhost:3001/**
#       http://127.0.0.1:3000/**
#
# Login surfaces:
#   - Customer login (/account/login): Google OAuth + email magic link.
#   - Staff settings login (/settings/login): Google OAuth only.
#
# Comma-separated allowlist of staff emails permitted into the admin/settings
# area. A matching email can sign in and bootstrap the owner role before any
# admin_users rows exist (see Admin RBAC). Note: sg@mpillow.com and
# admin@mpillow.com are always allowed in code regardless of this value.
ADMIN_BOOTSTRAP_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Bearer secret for /api/cron/* routes. Required in production.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Telegram (inventory commands; review cards and website chats go to the
# measurements group, and staff replies there reach the chat on /support)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional comma-separated chat id allowlist; empty = allow all
TELEGRAM_ALLOWED_CHATS=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Prefer a Restricted API Key (rk_...) over the full secret key (sk_...).
# Scopes needed by this app: Products (Write), Prices (Write),
# Checkout Sessions (Write), Payment Links (Write), PaymentIntents (Read/Write),
# Charges (Read), Refunds (Write). Generate in Dashboard > Developers > API keys.
#
# Local E2E (test cards like 4242…): Dashboard must be in Test mode (toggle
# top-right). Keys must start with sk_test_ / rk_test_ / pk_test_ — live keys
# reject test card numbers. Probe UI: http://localhost:3000/stripe-test
# Webhooks: npm run stripe:listen  → paste printed whsec_… below, restart dev.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook.
# Dashboard > Developers > Webhooks (whsec_...). For local dev use the value
# printed by: npm run stripe:listen
STRIPE_WEBHOOK_SECRET=
# Optional: only needed if you embed Stripe Elements. The storefront currently
# redirects to hosted Checkout, so this can be left blank.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to "true" to let Stripe Tax compute GST on the post-discount amount
# (writes the final tax/total back from the completed session). PREREQUISITE:
# enable Stripe Tax and add the SG GST registration in the Dashboard first,
# otherwise automatic_tax returns 0 / errors. Left blank/false keeps the manual
# exclusive-tax line item. The discount-as-coupon fix is always on regardless.
STRIPE_AUTOMATIC_TAX=
# Optional: Stripe tax code applied to synced Products (Stripe Tax category).
# Defaults to txcd_99999999 (General - Tangible Goods).
STRIPE_TAX_CODE=

# ---------------------------------------------------------------------------
# Easyship (live shipping rates + labels, ADR 0020)
# ---------------------------------------------------------------------------
# API access token: Easyship dashboard > Connect > API Integrations > Generate.
# A sandbox token (sand_...) talks to the sandbox host, so it can never buy a
# real label; a production token (prod_...) does. Leave blank to keep every
# shipping method on its flat rate. The rest (ship-from address, box sizes,
# markup) is configured in Settings > Shipping > Easyship.
EASYSHIP_API_TOKEN=
# Signing secret of the webhook pointing at /api/shipping/easyship/webhook
# (Easyship > Connect > API Integrations > Webhooks). Subscribe it to
# shipment.label.created, shipment.label.failed and
# shipment.tracking.status.changed. Without it the webhook accepts nothing.
EASYSHIP_WEBHOOK_SECRET=
# Optional: pin the API version (default 2024-09) or point at a mock host.
EASYSHIP_API_VERSION=
EASYSHIP_API_BASE_URL=

# ---------------------------------------------------------------------------
# Shopify (inventory sync)
# ---------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=

# ---------------------------------------------------------------------------
# Google Maps / Places (store locator, reviews)
# Each uncached reviews read is billed (Place Details Enterprise + Atmosphere).
# Leave the key unset in Preview and local dev: the landing page shows its
# placeholder testimonials instead.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_MAPS_API_REFERRER=http://localhost:3000/

# ---------------------------------------------------------------------------
# Google OAuth (same client; two identities)
# ---------------------------------------------------------------------------
# Shared client:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# Appointments — admin@mpillow.com (Calendar + Contacts). Do not add Drive here.
#   https://www.googleapis.com/auth/calendar
#   https://www.googleapis.com/auth/contacts
# Enable: https://console.developers.google.com/apis/api/calendar-json.googleapis.com
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
#
# Media Asset Library — sg@mpillow.com (Drive readonly). Separate refresh token.
#   https://www.googleapis.com/auth/drive.readonly
# Enable: https://console.developers.google.com/apis/api/drive.googleapis.com
# Skip Drive UI Integration / Open URL (API-only). See OPS-CHECKLIST.md.
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
#
# Google review replies — sg@mpillow.com (manages the Business Profile).
# Separate refresh token, scope:
#   https://www.googleapis.com/auth/business.manage
# Needs Business Profile API access approval first (0 quota until then).
# See .claude/PRD-google-review-replies/OPS-CHECKLIST.md.
GOOGLE_BUSINESS_OAUTH_REFRESH_TOKEN=
# accounts/{accountId}/locations/{locationId} — printed by
# scripts/google-business-setup.ts
GOOGLE_BUSINESS_LOCATION=
# Shared secret in the Pub/Sub push subscription's endpoint URL:
#   https://<site>/api/webhooks/google-reviews?token=<this>
GOOGLE_REVIEWS_PUSH_TOKEN=

# ---------------------------------------------------------------------------
# Customer messages: Facebook Messenger + Instagram + TikTok → Telegram
# See .claude/PRD-social-inbox/OPS-CHECKLIST.md
# ---------------------------------------------------------------------------
# Meta (one app, one Page). A never-expiring Page token from a system user with
# pages_messaging, pages_manage_metadata, pages_show_list,
# pages_read_engagement, instagram_basic, instagram_manage_messages.
META_PAGE_ACCESS_TOKEN=
# App settings → Basic → App secret (the same app as WhatsApp → same value as
# WHATSAPP_APP_SECRET). Signs webhooks; production refuses them without it.
META_APP_SECRET=
# Any random string; typed into the Meta webhook settings for
#   https://<site>/api/webhooks/meta-messages  (objects Page + Instagram)
META_WEBHOOK_VERIFY_TOKEN=
# Printed by scripts/social-inbox-setup.ts. Optional: webhooks for any other
# Page or Instagram account are ignored when set.
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
# true once Meta approves the Human Agent feature: replies allowed for 7 days
# after the customer's last message instead of 24 hours.
META_HUMAN_AGENT_ENABLED=
# Graph API version for Messenger/Instagram calls (default v24.0).
META_GRAPH_VERSION=
#
# TikTok for Business developer app (Business Messaging). The account itself
# is connected from Settings → Staff Management → Telegram access; its rotating
# tokens are stored in the database, not here.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ---------------------------------------------------------------------------
# Anthropic (Claude drafts Google review replies; staff approve in Telegram)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (appointment confirm / reschedule)
# ---------------------------------------------------------------------------
# Two numbers, different jobs — do not conflate them:
#   utility sender  automated, whichever number WHATSAPP_PHONE_NUMBER_ID names.
#                   Sends appointment templates and handles Confirm /
#                   Reschedule replies. Nobody reads what guests type to it.
#   +65 8780 5311   staffed sales line customers chat to. Public-facing only,
#                  never used by the Cloud API — see NEXT_PUBLIC_SUPPORT_WHATSAPP.
# System user token: whatsapp_business_messaging, whatsapp_business_management,
# business_management.
WHATSAPP_TOKEN=
# Meta's *phone number ID* for the utility sender, not the number itself. Read it
# from Meta Business Manager → WhatsApp → API Setup, or run
# scripts/whatsapp-discover.ts. Changing the sending number means changing this
# ID — there is no phone number anywhere in the code.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional, both only used by scripts/whatsapp-preflight.ts to find the WABA that
# owns the number. A system-user token cannot call debug_token on itself, so set
# WHATSAPP_APP_ID (an app access token is then app-id|app-secret), or skip the
# lookup entirely by pinning WHATSAPP_WABA_ID from scripts/whatsapp-discover.ts.
WHATSAPP_APP_ID=
WHATSAPP_WABA_ID=
# Approved English utility template names (Meta Business Manager). The
# day-before one must carry the Confirm / Reschedule quick replies — the
# original appointment_day_before does not; _v2 does. The cancel one should
# name the staffed line — appointment_cancelled_v2 does; the original
# appointment_cancelled (still sent in its own 2-param shape) does not.
WHATSAPP_TEMPLATE_DAY_BEFORE=appointment_day_before_v2
WHATSAPP_TEMPLATE_MORNING_OF=appointment_morning_of
WHATSAPP_TEMPLATE_CANCEL=appointment_cancelled_v2
# Immediate booking confirmation for bookings 2+ days out (or tomorrow, before
# the 09:00 run). Short-notice bookings get their reminder at booking time
# instead, so they are covered either way. Unset = no message at booking time.
# Name an approved 4-param template to switch it on.
WHATSAPP_TEMPLATE_CONFIRM=
# Aftercare templates (CRM slice 13): the review request after delivery and the
# yearly check-up, 5 body params and a URL button each. Copy is owner-approved
# in lib/whatsapp/aftercare-templates.ts; submit with
# scripts/whatsapp-create-templates.ts, then run preflight. Unset = aftercare
# WhatsApp is skipped and email still goes. Set each to its name
# (aftercare_review_request / aftercare_checkup) once Meta shows it Approved.
WHATSAPP_TEMPLATE_AFTERCARE_REVIEW=
WHATSAPP_TEMPLATE_AFTERCARE_CHECKUP=
# Non-prod only: comma-separated E.164 allowlist; empty = allow all
WHATSAPP_ALLOWLIST=
# Public contact number shown on marketing, support, and privacy pages (E.164
# digits, no +). Single source of truth — see lib/contact.ts. This is the STAFFED
# SALES line and is deliberately NOT the utility sender above; never point it at
# WHATSAPP_PHONE_NUMBER_ID's number or customers will message an unread inbox.
# Build-time inlined: a change needs a redeploy.
NEXT_PUBLIC_SUPPORT_WHATSAPP=6587805311

# ---------------------------------------------------------------------------
# Email (support contact + transactional)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_EMAIL=
GMAIL_SENDER=
GMAIL_PRIVATE_KEY=
# Aftercare emails (CRM slice 07's review request, slice 08's check-up) outside
# production (VERCEL_ENV other than production, or a local run): comma-separated
# addresses they may go to. Empty = none, so a preview or a local run sharing the
# database never emails a real customer. Ignored in production.
AFTERCARE_EMAIL_ALLOWLIST=

# One-click unsubscribe (PRD-shopify-customer-migration slice 07). Signs the
# unsubscribe link in every marketing email: HMAC-SHA256 of the Customer id.
# Any long random string, e.g. `openssl rand -hex 32`. Never rotate it once
# marketing email has gone out: every link already sent would stop working.
# Unset → POST /api/email/unsubscribe answers 503, and a campaign sender
# refuses to run (check: npx tsx lib/marketing-consent/unsubscribe-route.check.ts <site>).
UNSUBSCRIBE_SECRET=

# Campaign email (PRD-shopify-customer-migration slice 08; owner decision 4). Every
# campaign goes through Resend from its own sending subdomain, never the Gmail mailbox
# above: Admin Panel → Email campaigns (PRD-email-marketing; set these in Vercel) and
# scripts/customer-migration-send.ts both refuse to send until all three are set and
# the From is on the subdomain. The key is deliberately NOT
# RESEND_API_KEY: that name would switch every order email to Resend.
CAMPAIGN_RESEND_API_KEY=
# e.g. `Mpillow <hello@hello.mpillow.com>`; must be on CAMPAIGN_EMAIL_DOMAIN.
CAMPAIGN_EMAIL_FROM=
# The sending subdomain, with Resend's SPF and DKIM and a DMARC record (slice 09).
CAMPAIGN_EMAIL_DOMAIN=
# Resend → Webhooks → the endpoint https://<site>/api/email/resend-webhook (events
# email.bounced, email.complained) → its signing secret, `whsec_…`. Unset → the
# route answers 503 and bounces and complaints are not recorded.
CAMPAIGN_RESEND_WEBHOOK_SECRET=
# What the Resend plan may send. Unset → the free plan: 100 a day, 3,000 a month.
# The sender keeps every run inside both and holds the rest of a wave for the next
# day. Raise them on a paid plan; lower them if anything else uses the account.
# CAMPAIGN_DAILY_SEND_LIMIT=100
# CAMPAIGN_MONTHLY_SEND_LIMIT=3000
# The support inbox: on Cc, with sg@mpillow.com, of every website chat transcript
# emailed to a customer, the Reply-To on campaign mail, and its mailto
# unsubscribe. Unset → the transactional From (GMAIL_SENDER) is used.
# SUPPORT_EMAIL=

# Search Console ingest (PRD-search-visibility slice 01). Service account added to the
# GSC property as a Restricted user; the same account is reused for the GA4 Data API.
# Site URL is the property id exactly as GSC shows it: `sc-domain:mpillow.com` or
# `https://custom.mpillow.com/`. Unset → the daily ingest is a no-op.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# IndexNow (PRD-search-visibility slice 15): pings Bing and other IndexNow engines
# when a blog post is published, updated or unpublished. 8–128 chars [A-Za-z0-9-],
# e.g. `openssl rand -hex 16`. Served at /indexnow-key.txt; only pings when
# VERCEL_ENV=production. Unset → no pings, key file 404s.
INDEXNOW_KEY=

# Google Merchant Center feed (PRD-search-visibility slice 13). Merchant Center
# fetches /api/merchant-feed?token=<this> on a schedule. Any long random string,
# e.g. `openssl rand -hex 24`. Unset → the feed 404s.
MERCHANT_FEED_TOKEN=
# EMAIL_FROM=
