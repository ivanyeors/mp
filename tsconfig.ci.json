{
  // CI typecheck config.
  //
  // Identical to tsconfig.json — test files (`**/__tests__/**`, `**/*.test.ts`,
  // `**/*.test.tsx`) now typecheck clean and are included in the gate.
  // `*.check.ts` scripts and `scripts/**` stay excluded: they're standalone
  // `npx tsx <file>` scripts, not part of the app's module graph, and some
  // (e.g. `lib/seo/answer-lede-coverage.check.ts`) intentionally use loose
  // typing to scan arbitrary source text.
  //
  // `exclude` is replaced, not merged, by `extends`, so the base excludes are
  // repeated here.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "**/*.check.ts",
    "scripts/**"
  ]
}
