#!/usr/bin/env bash
# Refuse to push a commit Vercel will not build.
#
# Vercel blocks a deployment whose commit AUTHOR is not a member of the team
# owning the project, and it blocks it silently: no build, no failing check,
# just a pull request with no preview. The cost of finding that out is a round
# trip through GitHub and Vercel; the cost of finding it out here is nothing.
#
# Installed by scripts/git-identity, which sets core.hooksPath to this
# directory. That script also pins the author, so in the normal case this hook
# has nothing to say. It exists for the cases the script cannot reach: a clone
# made before it landed, a tool that writes its own identity, a machine where
# nobody ran it.
#
# Bypass a single push with --no-verify. Do that knowing the preview will not
# build — production still will, because GitHub re-authors on squash-merge.
set -uo pipefail

# Every identity that maps to a member of the Vercel team `ivanyeors-projects`.
# Add a line when someone joins the team — not before. An address that is not
# on the team is exactly what this hook is here to catch, and widening the list
# to silence it trades a loud local failure for a silent remote one.
ALLOWED=(
  "47745593+ivanyeors@users.noreply.github.com"   # ivanyeors, via GitHub noreply
  "ivanyeoart@gmail.com"                          # ivanyeors, Vercel account address
)

zero='0000000000000000000000000000000000000000'
offenders=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote branch pushes the null sha. Nothing to inspect.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # A branch the remote has never seen: everything on it that is not already
    # published somewhere on origin. Without --not this walks the whole history
    # of main and reports years of commits nobody is pushing.
    range=("$local_sha" --not --remotes=origin)
  else
    range=("${remote_sha}..${local_sha}")
  fi

  while read -r sha email subject; do
    [ -z "$sha" ] && continue
    for allowed in "${ALLOWED[@]}"; do
      [ "$email" = "$allowed" ] && continue 2
    done
    offenders="${offenders}  ${sha:0:9}  ${email}  ${subject}"$'\n'
  done < <(git log --format='%H %ae %s' "${range[@]}" 2>/dev/null)
done

[ -z "$offenders" ] && exit 0

cat >&2 <<MSG

---------------------------------------------------------------
Push stopped: these commits are authored by someone Vercel will
not build for.

${offenders}
Vercel only builds a commit whose author is a member of the team
that owns mp-inv. A commit by anyone else is not built and not
failed — the deployment is created in state BLOCKED and the pull
request shows no preview at all, with nothing anywhere saying why.

Fix, from the repo root:

    ./scripts/git-identity          # pin this clone, once
    git rebase --exec 'git commit --amend --no-edit --reset-author' \\
      origin/main                   # re-author what is already committed
    git push

If these commits belong to someone who should be on the team, add
them in Vercel (Settings -> Members) and add their address to
ALLOWED in .githooks/pre-push. See CLAUDE.md, "Commit author".

To push anyway and accept no preview build: git push --no-verify
---------------------------------------------------------------
MSG

exit 1
