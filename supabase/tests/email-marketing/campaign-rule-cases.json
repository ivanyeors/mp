    { "name": "rest: never agreed reads not subscribed first", "audience": "subscribed", "customer": { "migrated": false, "marketing_email": "not_subscribed", "recent": [{ "daysAgo": 1 }] }, "expected": "not_subscribed" },
    { "name": "rest: already sent this campaign reads already sent first", "audience": "subscribed", "customer": { "migrated": false, "marketing_email": "subscribed", "own": "sent", "recent": [{ "daysAgo": 1 }] }, "expected": "already_sent" },
    { "name": "rest: retrying this campaign's failure while resting", "audience": "subscribed", "retryFailed": true, "customer": { "migrated": false, "marketing_email": "subscribed", "own": "failed", "recent": [{ "daysAgo": 2 }] }, "expected": "resting" },
    { "name": "rest: imported audience, unclaimed, resting", "audience": "imported_not_signed_in", "customer": { "migrated": true, "marketing_email": "subscribed", "claimed": false, "recent": [{ "daysAgo": 2 }] }, "expected": "resting" },
