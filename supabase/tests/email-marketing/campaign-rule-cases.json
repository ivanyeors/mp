    { "name": "imported: a reminder of theirs drew a complaint", "audience": "imported_not_signed_in", "customer": { "migrated": true, "marketing_email": "subscribed", "suppressedBy": "complained" }, "expected": "suppressed" },
    { "name": "imported: a migration email went out fine", "audience": "imported_not_signed_in", "customer": { "migrated": true, "marketing_email": "subscribed", "suppressedBy": "sent" }, "expected": null },
