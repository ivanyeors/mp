    { "name": "holdout: held out, then unsubscribed, reads unsubscribed first", "audience": "subscribed", "customer": { "migrated": false, "marketing_email": "unsubscribed", "own": "held_out" }, "expected": "unsubscribed" },
    { "name": "holdout: held out of another campaign is no email, so no rest", "audience": "subscribed", "customer": { "migrated": false, "marketing_email": "subscribed", "recent": [{ "daysAgo": 1, "status": "held_out" }] }, "expected": null }
