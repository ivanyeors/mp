{
  "about": "Who may receive an email campaign Staff wrote (PRD-email-marketing). composedCampaignBlocker (lib/email-campaigns/rules.ts) and marketing_campaign_blocker() (20261021100000) must give each case's `expected`. `suppressedBy` adds a migration send of theirs with that status; `own` is this campaign's send to them.",
  "cases": [
    { "name": "imported: unclaimed, subscribed", "audience": "imported_not_signed_in", "customer": { "migrated": true, "claimed": false, "marketing_email": "subscribed" }, "expected": null },
