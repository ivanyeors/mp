{
  "about": "Who may receive an email campaign Staff wrote (PRD-email-marketing). composedCampaignBlocker (lib/email-campaigns/rules.ts) and marketing_campaign_blocker() (20261021100000) must give each case's `expected`. `suppressedBy` adds a migration send of theirs with that status; `own` is this campaign's send to them. `recent` (PRD-campaign-audiences slice 07) is their other email, each `daysAgo`: `kind` campaign (another campaign's send, `status` default sent), points_expiry (a sent points-expiry reminder) or transactional (an order email, which never counts). Suppressing rows are dated 60 days ago, outside the rest period. `held_out` (PRD-campaign-audiences slice 11) is a row a holdout kept back: never sent, read before already_sent, and no marketing email for the rest period.",
  "cases": [
    { "name": "imported: unclaimed, subscribed", "audience": "imported_not_signed_in", "customer": { "migrated": true, "claimed": false, "marketing_email": "subscribed" }, "expected": null },
    { "name": "imported: not a Migrated customer", "audience": "imported_not_signed_in", "customer": { "migrated": false, "marketing_email": "subscribed" }, "expected": "not_migrated" },
    { "name": "imported: already Claimed", "audience": "imported_not_signed_in", "customer": { "migrated": true, "claimed": true, "marketing_email": "subscribed" }, "expected": "claimed" },
    { "name": "imported: Claimed and unsubscribed reads Claimed first", "audience": "imported_not_signed_in", "customer": { "migrated": true, "claimed": true, "marketing_email": "unsubscribed" }, "expected": "claimed" },
    { "name": "imported: unsubscribed", "audience": "imported_not_signed_in", "customer": { "migrated": true, "marketing_email": "unsubscribed" }, "expected": "unsubscribed" },
    { "name": "imported: never agreed", "audience": "imported_not_signed_in", "customer": { "migrated": true, "marketing_email": "not_subscribed" }, "expected": "not_subscribed" },
