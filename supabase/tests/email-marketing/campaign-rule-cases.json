    { "name": "rest: 3 campaigns and a points-expiry reminder make 4 in 30 days", "audience": "subscribed", "customer": { "migrated": false, "marketing_email": "subscribed", "recent": [{ "daysAgo": 9 }, { "daysAgo": 15, "kind": "points_expiry" }, { "daysAgo": 22 }, { "daysAgo": 28 }] }, "expected": "resting" },
    { "name": "rest: an order email 1 day ago never counts", "audience": "subscribed", "customer": { "migrated": false, "marketing_email": "subscribed", "recent": [{ "daysAgo": 1, "kind": "transactional" }] }, "expected": null },
    { "name": "rest: a failed send 1 day ago reached nobody", "audience": "subscribed", "customer": { "migrated": false, "marketing_email": "subscribed", "recent": [{ "daysAgo": 1, "status": "failed" }] }, "expected": null },
