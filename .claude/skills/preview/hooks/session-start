#!/usr/bin/env bash
# SessionStart hook: record the page files as they are when the session
# begins, so stop-check only asks about content that changes from here on.
# A compaction continues the same session, so it keeps the earlier record.
input="$(cat 2>/dev/null || true)"
case "$input" in *'"source":"compact"'* | *'"source": "compact"'*) exit 0 ;; esac
root="$(git -C "${CLAUDE_PROJECT_DIR:-.}" rev-parse --show-toplevel 2>/dev/null)" || exit 0
mkdir -p "$root/.preview" && "$(dirname "$0")/ui-snapshot" >"$root/.preview/seen"
exit 0
