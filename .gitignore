.pnpm-store/
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
!.env.example

# service account keys / secrets
.secrets/
*-key.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local CLI link artifacts
supabase/.temp/
.claude/worktrees/

# graphify — generated index artifacts
# graph.json / GRAPH_REPORT.md / manifest.json ARE committed so a fresh clone
# has the graph without a rebuild. These are not:
#   cache/     AST cache, rebuilt locally
#   <date>/    dated run backups (~13MB each)
#   .graphify_root / .graphify_python  absolute paths of whoever built it
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/.graphify_analysis.json

# Local scratch output (email previews, ad-hoc dumps).
/.scratch/


# Renders
renders
# mpillow-office: plan_check / plan_read raster cache, plan_check's pictures
# and report (regenerated in seconds), Python caches
mpillow-office/plans/.cache/
mpillow-office/model/*_check.png
mpillow-office/model/*_check.json
mpillow-office/model/*_zones.png
mpillow-office/**/__pycache__/
package-lock.json
